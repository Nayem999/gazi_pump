# The Gazi Pump SFA cloud API base URL (no trailing slash).
SFA_API_BASE_URL=https://sfa.example.com/api/v1

# The Sync Agent credential shown once when the connection was created (or
# regenerated) on the SFA admin's Tally Connections page. Treat this like a
# password — never commit it.
SFA_AGENT_TOKEN=

# TallyPrime's own HTTP-XML gateway on this same machine — never a public
# address (see docs/tally-sfa-integration.md's architecture diagram).
#
# 9000 is the "Client/Server and ODBC Services" port — Tally's own
# F12 > Advanced Configuration > Client/Server configuration screen
# ("TallyPrime acts as: Both, Enable ODBC: Yes, Port: 9000"), verified
# live against this customer's instance. Do NOT use 9999, the "Tally
# Gateway Server" port shown in the same About panel: that's Tally's own
# licensing/online-services connection and does not speak the XML
# import/export protocol.
TALLY_HOST=localhost
TALLY_PORT=9000

# The Tally group this customer files dealer/retailer ledgers under.
#
# This must name the ledger's IMMEDIATE parent group, not an ancestor:
# Tally's $Parent holds one group name, so "Current Assets" matches nothing
# even though Sundry Debtors sits underneath it. Verified against the real
# "GDN Tally" company — "Sundry Debtors" returns its dealers, "Current
# Assets" returns zero rows.
#
# So check the customer's actual chart of accounts (Gateway of Tally >
# Chart of Accounts > Ledgers) and name the group the dealers hang off
# directly. `npm run doctor` prints which group it checked and what it
# found, which is the quickest way to confirm.
TALLY_DEALER_LEDGER_GROUP=Sundry Debtors

# The group retailers are filed under — no default, and it must differ from
# the dealer group above. A Tally ledger carries no "dealer vs retailer"
# flag, so the grouping is the only signal; when both pulls read one group,
# every dealer gets imported a second time as a retailer of the same name.
# Left blank, the retailer pull imports nothing and says why, which is the
# safe outcome for a customer who keeps all parties in one group.
TALLY_RETAILER_LEDGER_GROUP=

# How often to send a heartbeat and poll for new jobs, in seconds.
HEARTBEAT_INTERVAL_SECONDS=60
POLL_INTERVAL_SECONDS=30

# How often to push a full godown-wise stock snapshot to SFA, in seconds.
# Stock is a bulk overwrite, not a per-record job, so it runs on its own
# schedule rather than through the job queue (see stockSnapshot.js).
STOCK_SYNC_INTERVAL_SECONDS=900

# Where the local offline-buffer queue file lives (created automatically).
LOCAL_QUEUE_FILE=./local-queue.json
