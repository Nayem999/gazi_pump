APP_NAME="Gazi Pump SFA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gazi_pump_sfa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tally single-depot stock mode: the depots.code that receives the whole
# company's Tally stock. Needed because the live TallyPrime cannot serve
# item x godown quantities (see docs/tally-sfa-integration.md). Leave blank
# to disable — godown-less rows are then skipped rather than landing on an
# arbitrary depot.
SFA_TALLY_DEFAULT_DEPOT_CODE=

# Month a Tally financial year opens on (9 = September, per "GDN Tally").
SFA_TALLY_FY_START_MONTH=9

# Lets "Sync Now" CREATE masters inside Tally — a Ledger, Stock Item or
# Godown for each active SFA record that has no Tally counterpart.
#
# Off by default on purpose. Every other sync either reads from Tally or
# writes a voucher an operator already approved; this one writes permanent
# chart-of-accounts and inventory masters, which an accountant may
# reasonably consider theirs to own. Turn it on knowingly.
SFA_TALLY_MASTER_PUSH_ENABLED=false

# The Tally groups pushed ledgers are filed under. These must match the
# agent's TALLY_DEALER_LEDGER_GROUP / TALLY_RETAILER_LEDGER_GROUP — a
# dealer pushed into a group the pull does not read would go out and never
# come back. Retailers have no default: without one, they are not pushed.
SFA_TALLY_DEALER_LEDGER_GROUP=Sundry Debtors
SFA_TALLY_RETAILER_LEDGER_GROUP=

# The Tally stock group pushed products are filed under. Blank means "let
# Tally use its own root": Tally stores reserved roots with a leading space
# (" Primary") that XML cannot carry, and rejects the space-less spelling.
# Set it to a group the customer already uses to file products there.
SFA_TALLY_STOCK_ITEM_GROUP=

# Unit for pushed stock items. Must already exist in the Tally company —
# Tally rejects an unknown unit rather than creating it.
SFA_TALLY_STOCK_ITEM_UNIT=PCS

# Order the Swagger UI tag sections A-Z. Set to null to keep them in the
# order swagger-php discovers the controllers.
L5_SWAGGER_UI_TAGS_SORTER=alpha

# Order the operations within each tag: 'reads-first' puts GET/HEAD/OPTIONS
# ahead of POST/PUT/PATCH and DELETE last, each group by path. Also accepts
# 'alpha' (by path), 'method' (Swagger UI's own verb grouping, which leads
# with DELETE) or null (declaration order).
L5_SWAGGER_OPERATIONS_SORT=reads-first
