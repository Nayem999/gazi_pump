  {
   "name": "Leave",
   "item": [
    {
     "name": "List Leave Types",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/leave/types",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "leave",
        "types"
       ]
      },
      "description": "Active leave types available to request. annual_quota is the default entitlement, not the caller's remaining balance - use Leave Balance for that."
     }
    },
    {
     "name": "Leave Balance",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/leave/balance?year=2026",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "leave",
        "balance"
       ],
       "query": [
        {
         "key": "year",
         "value": "2026"
        }
       ]
      },
      "description": "The caller's own balance per leave type. used_days is summed from approved requests, so it always agrees with the request list. remaining_days CAN be negative when leave was approved beyond entitlement - show it rather than clamping to zero. Omit `year` for the current one."
     }
    },
    {
     "name": "My Leave Requests",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/leave/requests?status=pending",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "leave",
        "requests"
       ],
       "query": [
        {
         "key": "status",
         "value": "pending"
        }
       ]
      },
      "description": "The caller's own requests only - user_id is pinned server-side and never read from the query string. Optional `status`: pending, approved, rejected, cancelled. Paginated via `per_page`."
     }
    },
    {
     "name": "Submit Leave Request",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"leave_type_id\": 1,\n  \"from_date\": \"2026-09-14\",\n  \"to_date\": \"2026-09-15\",\n  \"is_half_day\": false,\n  \"reason\": \"Family wedding.\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{base_url}}/leave/requests",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "leave",
        "requests"
       ]
      },
      "description": "Submits a request as the authenticated user; it starts Pending and changes no attendance until a manager approves it.\n\n`days` comes back as WORKING days - weekends and recorded holidays are already excluded, so do not recompute it from the dates.\n\nSet is_half_day for a single date (from_date must equal to_date); it counts 0.5 days.\n\nReturns 422 when the range overlaps existing pending/approved leave, when it contains no working days at all, or when a half day spans two dates."
     }
    },
    {
     "name": "Get Leave Request",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/leave/requests/1",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "leave",
        "requests",
        "1"
       ]
      },
      "description": "One of the caller's own requests. 403 for a colleague's."
     }
    },
    {
     "name": "Withdraw Leave Request",
     "request": {
      "method": "DELETE",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/leave/requests/1",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "leave",
        "requests",
        "1"
       ]
      },
      "description": "Withdraws a request. Allowed while Pending, and for approved leave that has NOT started yet (its attendance rows are removed again). Approved leave already under way returns 422 - those days were genuinely taken.\n\nRead can_cancel on a request to decide whether to show the button."
     }
    }
   ],
   "description": "Self-service leave for the mobile app.\n\nThere is deliberately NO approve/reject endpoint here: deciding someone else's leave is an admin web action, and exposing it to the mobile API would put an approval button one permission mistake away from every phone in the field."
  },
  {
