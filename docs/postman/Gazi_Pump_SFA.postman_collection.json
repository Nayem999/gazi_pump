        "key": "Accept",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n    \"dealer_code\": \"DLR-{{$timestamp}}\",\n    \"name\": \"Karim Traders\",\n    \"phone\": \"01712345678\",\n    \"email\": null,\n    \"address\": null,\n    \"gps_lat\": 23.8103,\n    \"gps_lng\": 90.4125,\n    \"territory_id\": null\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{base_url}}/dealers",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dealers"
       ]
      },
      "description": "Register a new dealer from the field. `territory_id` defaults to the authenticated user's own territory when omitted."
     }
    },
    {
     "name": "Dealer Outstanding Balance",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/dealers/1/outstanding-balance",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dealers",
        "1",
        "outstanding-balance"
       ]
      },
      "description": "Get a dealer's outstanding balance. Returns the real Tally-synced balance once this dealer's ledger has been pulled (Phase 5); otherwise the SFA-computed estimate (total ordered minus total collected) - source in the response says which one."
     }
    },
    {
     "name": "Dealer Ledger",
     "request": {
      "method": "GET",
      "header": [
       {
        "key": "Accept",
        "value": "application/json"
       }
      ],
      "url": {
       "raw": "{{base_url}}/dealers/1/ledger",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "dealers",
        "1",
        "ledger"
       ]
      },
      "description": "Get a dealer's full due history - every order (debit) and collection (credit), chronologically, with a running balance. Uses the real Tally-synced ledger once this dealer's has been pulled (Phase 5); otherwise the same SFA-computed estimate as Dealer Outstanding Balance."
     }
    }
   ]
